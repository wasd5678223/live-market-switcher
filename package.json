{
  "name": "live-market-switcher",
  "version": "0.1.0",
  "private": true,
  "description": "Local danmaku-driven OBS video scheduler",
  "main": "dist-main/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:5173 dist-main/main/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "node scripts/copy-ocr-assets.mjs && vite build",
    "start": "electron .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "dependencies": {
    "lucide": "^0.468.0",
    "obs-websocket-js": "5.0.8",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "43.2.0",
    "typescript": "^5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "wait-on": "^9.0.3"
  }
}
